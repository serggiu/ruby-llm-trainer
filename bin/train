#!/usr/bin/env ruby
# frozen_string_literal: true

# Rebuilds the MLX chat-format slice from the fresh SFT set and runs LoRA
# training on it.
#
# Usage:
#   ruby bin/train [--iters 1000] [--slice proper|smoke|full] [--adapter DIR]
#                  [--watchdog] [--resume] [--force] [--model DIR] [--restore DIR]
#                  [--dry-run]
#
#   --iters N       training iterations (default 1000)
#   --slice NAME    data slice: smoke (300/50), proper (3000/200), full (20000/700)
#   --adapter DIR   adapter output dir (default _mlx/adapters_qwen3)
#   --watchdog      supervise the run with the memory watchdog (WATCHDOG=1)
#   --resume        continue from the latest adapter checkpoint instead of a fresh run
#   --force         discard any trained (unexported) state and start fresh from the base
#   --model DIR     model directory (default: the Qwen3-8B MLX cache)
#   --restore DIR   roll back to a saved model state (a snapshot dir), then exit
#   --dry-run       print the commands without running them
#
# Without --resume or --force, bin/train refuses to run over a trained model
# that hasn't been exported yet.
#
# Small datasets are handled automatically: when the SFT set is smaller than
# the slice's train count, ~20% is held out for validation (min 10 entries)
# so training always has a generalization signal.
#
# Data root: LLM_TRAINER_ROOT env override (used by tests to run in a
# sandbox); the scripts/venv always come from this repository.

require "rbconfig"
require "fileutils"

SCRIPTS = File.expand_path("..", __dir__) # this repository (scripts, .venv)
ROOT = ENV["LLM_TRAINER_ROOT"] || SCRIPTS # where _dataset/, _mlx/ live
RUBY = RbConfig.ruby

SLICES = {
  "smoke"  => [300, 50],
  "proper" => [3000, 200],
  "full"   => [20_000, 700],
}.freeze

# Reserves a held-out validation slice from a dataset too small for the
# requested slice: ~20% for validation (at least 10 when the dataset allows,
# never more than half), so mlx-lm always has something to evaluate against.
# Returns [train_count, valid_count].
def auto_split_counts(total)
  valid = (total * 0.2).round
  valid = [valid, 10].max
  valid = [valid, total / 2].min
  [total - valid, valid]
end

# Line count of a JSONL file (used to detect small datasets).
def count_entries(path)
  count = 0
  File.foreach(path) { count += 1 }
  count
end

# Copies the current adapter dir into _mlx/snapshots/pre_<slice>_<timestamp>
# before a training run starts, so a bad session can be rolled back with
# --restore. Returns the snapshot path, or nil when there is nothing to
# snapshot yet (first run).
def snapshot_adapter(adapter_dir, slice, snapshots_root)
  return nil unless File.file?(File.join(adapter_dir, "adapters.safetensors"))

  snap = File.join(snapshots_root, "pre_#{slice}_#{Time.now.strftime('%Y%m%d_%H%M%S')}")
  FileUtils.mkdir_p(File.dirname(snap))
  FileUtils.cp_r(adapter_dir, snap)
  snap
end

# Restores a snapshot into the adapter dir (replacing whatever is there).
# Aborts with a friendly message if the snapshot is missing or incomplete.
def restore_adapter(snapshot_dir, adapter_dir)
  unless File.directory?(snapshot_dir) && File.file?(File.join(snapshot_dir, "adapters.safetensors"))
    abort "Snapshot not found: #{snapshot_dir}\n" \
          "(expected adapters.safetensors inside it — check the path and retry)"
  end
  FileUtils.rm_rf(adapter_dir)
  FileUtils.mkdir_p(File.dirname(adapter_dir))
  FileUtils.cp_r(snapshot_dir, adapter_dir)
end

# Removes the adapter dir for a fresh --force start.
def clear_adapter_dir(adapter_dir)
  FileUtils.rm_rf(adapter_dir)
end

# Parses the most recent session's val evals from the log into a summary:
# {baseline_val:, best_val:, best_iter:, final_val:, final_iter:} — or nil.
# Sessions are delimited by the "Starting training..., iters: N" markers;
# the first eval (iter 1) is the session's pre-training baseline.
def last_session_val_summary(log_path)
  return nil unless File.file?(log_path)

  session = nil
  File.foreach(log_path) do |line|
    session = [] if line.include?("Starting training..., iters:")
    m = line.match(/^Iter (\d+): Val loss ([\d.]+)/)
    session << [m[1].to_i, m[2].to_f] if m && session
  end
  return nil if session.nil? || session.empty?

  baseline = session.first
  best = session.min_by { |_, v| v }
  final = session.last
  {
    baseline_val: baseline[1], best_val: best[1], best_iter: best[0],
    final_val: final[1], final_iter: final[0],
  }
end

# If the last session drifted after its best eval (final val worse than the
# val-best), copy that best checkpoint over adapters.safetensors so the next
# --resume continues from the best-known state instead of the overfit final.
# Returns a message to print, or nil when there is nothing better to use
# (no log, no evals, no saved checkpoint, or the final already IS the best).
def resume_from_val_best(log_path, adapter_dir)
  s = last_session_val_summary(log_path)
  return nil if s.nil? || s[:best_iter] < 100 # first checkpoint is saved at iter 100

  best_file = File.join(adapter_dir, format("%07d_adapters.safetensors", s[:best_iter]))
  live = File.join(adapter_dir, "adapters.safetensors")
  return nil unless File.file?(best_file) && File.file?(live)
  return nil if FileUtils.compare_file(best_file, live) # no drift — final IS the best

  FileUtils.cp(best_file, live)
  "Resuming from the val-best checkpoint (iter #{s[:best_iter]}, val #{format('%.3f', s[:best_val])}) " \
    "instead of the drifted final (val #{format('%.3f', s[:final_val])})."
end

# Simple within-session evaluation: how much the session learned (best vs
# baseline) and whether it drifted late (final vs best). Returns advice lines.
def assess_session_summary(s)
  learned = s[:baseline_val] - s[:best_val]
  drift = s[:final_val] - s[:best_val]
  lines = []

  if learned > 0.05
    lines << "learned well — val #{format('%.3f', s[:baseline_val])} → best #{format('%.3f', s[:best_val])} @ iter #{s[:best_iter]} (improved by #{format('%.3f', learned)})"
  elsif learned < -0.05
    lines << "little learning — the best val #{format('%.3f', s[:best_val])} is worse than the session start #{format('%.3f', s[:baseline_val])}"
  else
    lines << "modest change — best val #{format('%.3f', s[:best_val])} vs session start #{format('%.3f', s[:baseline_val])}"
  end

  if drift > 0.05
    lines << "late-run drift — the final val #{format('%.3f', s[:final_val])} is worse than the best by #{format('%.3f', drift)}; bake the val-best checkpoint instead: ruby bin/export --checkpoint #{s[:best_iter]}"
  else
    lines << "stable — the final val #{format('%.3f', s[:final_val])} matches the best; the latest adapter is the best one"
  end
  lines
end

DEFAULT_MODEL_CACHE = File.expand_path(
  "~/.cache/huggingface/hub/models--Qwen--Qwen3-8B-MLX-4bit/snapshots/*/tokenizer.json"
)

# Parses ARGV and builds the plan. Raises ArgumentError on bad input.
# Returns a hash with the slice/command details (see test/test_train.rb).
def build_plan(argv, scripts:, data_root:, model_cache_glob: DEFAULT_MODEL_CACHE)
  iters = 1000
  slice = "proper"
  adapter = "_mlx/adapters_qwen3"
  watchdog = false
  resume = false
  force = false
  restore = nil
  dry_run = false
  model = nil

  args = argv.dup
  until args.empty?
    opt = args.shift
    case opt
    when "--iters"    then iters = Integer(args.shift)
    when "--slice"    then slice = args.shift
    when "--adapter"  then adapter = args.shift
    when "--model"    then model = args.shift
    when "--watchdog" then watchdog = true
    when "--resume"   then resume = true
    when "--force"    then force = true
    when "--restore"  then restore = args.shift
    when "--dry-run"  then dry_run = true
    else raise ArgumentError, "unknown option: #{opt}"
    end
  end

  raise ArgumentError, "--resume and --force are mutually exclusive" if resume && force

  raise ArgumentError, "unknown slice: #{slice} (use #{SLICES.keys.join(', ')})" unless SLICES.key?(slice)

  model ||= ENV["TOKENIZER_MODEL_DIR"]
  if model.nil? || model.empty?
    cached = Dir.glob(model_cache_glob).first
    raise ArgumentError, "no model found — pass --model DIR" if cached.nil?
    model = File.dirname(cached)
  end

  train_count, valid_count = SLICES[slice]
  slice_dir = File.join(data_root, "_mlx", "qwen3_#{slice}")
  sft_set = File.join(data_root, "_dataset", "sft_train_set.jsonl")

  build_cmd = [RUBY, File.join(scripts, "build", "build_mlx_data.rb"),
               train_count.to_s, valid_count.to_s, sft_set, slice_dir,
               "--max-chars=80000"]

  lora = File.join(scripts, ".venv", "bin", "mlx_lm.lora")
  train_cmd = [lora, "--model", model, "--train", "--data", slice_dir,
               "--adapter-path", File.join(data_root, adapter),
               "--iters", iters.to_s, "--batch-size", "1", "--learning-rate", "1e-5",
               "--steps-per-report", "20", "--steps-per-eval", "200",
               "--val-batches", "10", "--max-seq-length", "2048"]
  resume_file = nil
  if resume
    resume_file = File.join(data_root, adapter, "adapters.safetensors")
    train_cmd += ["--resume-adapter-file", resume_file]
  end
  run_cmd = [RUBY, File.join(scripts, "tools", "run_capped.rb"), "--", *train_cmd]

  {
    iters: iters, slice: slice, train_count: train_count, valid_count: valid_count,
    slice_dir: slice_dir, sft_set: sft_set, adapter: adapter, adapter_dir: File.join(data_root, adapter),
    model: model,
    watchdog: watchdog, resume: resume, resume_file: resume_file, restore: restore,
    force: force, dry_run: dry_run,
    lora: lora, build_cmd: build_cmd, run_cmd: run_cmd,
    log_path: File.join(data_root, "_mlx", "train_#{slice}.log"),
  }
end

# Runs a command, streaming its output to the terminal AND appending it to a
# log file (so progress can be checked later). Returns true on success.
# With append: true the log keeps previous content (used when resuming).
def run_with_log(cmd, log_path, env: {}, append: false)
  reader, writer = IO.pipe
  pid = Process.spawn(env, *cmd, out: writer, err: writer)
  writer.close

  FileUtils.mkdir_p(File.dirname(log_path))
  File.open(log_path, append ? "a" : "w") do |log|
    reader.each_line do |line|
      puts line
      log.write(line)
      log.flush
    end
  end
  Process.wait(pid)
  $?.success?
end

if __FILE__ == $PROGRAM_NAME
  begin
    plan = build_plan(ARGV, scripts: SCRIPTS, data_root: ROOT)
  rescue ArgumentError => e
    abort e.message
  end

  if plan[:restore]
    restore_adapter(plan[:restore], plan[:adapter_dir])
    puts "Restored #{plan[:restore]} → #{plan[:adapter_dir]}"
    exit 0
  end

  unless File.exist?(plan[:sft_set])
    abort "Training data not found: #{plan[:sft_set]}\n" \
          "Run `ruby bin/build` first to generate the SFT set, then retry."
  end

  if plan[:resume]
    unless File.file?(plan[:resume_file])
      abort "No checkpoint to resume from: #{plan[:resume_file]}\n" \
            "Run `ruby bin/train` once without --resume to create it, then retry."
    end
    msg = resume_from_val_best(plan[:log_path], plan[:adapter_dir])
    puts msg if msg
  end

  unless plan[:resume] || plan[:force]
    if File.file?(File.join(plan[:adapter_dir], "adapters.safetensors"))
      abort <<~MSG
        Trained model state found in #{plan[:adapter_dir]} that has not been exported yet.

        Continue training it instead:  ruby bin/train --resume
        Or discard it and start fresh: ruby bin/train --force
        (The current state is snapshotted to _mlx/snapshots/ before --force clears it.)
      MSG
    end
  end

  # Small-dataset handling: if the SFT set is smaller than the slice's train
  # count, the slice would leave nothing for validation — auto-split instead.
  total = count_entries(plan[:sft_set])
  train_count = plan[:train_count]
  valid_count = plan[:valid_count]
  if total <= train_count
    train_count, valid_count = auto_split_counts(total)
    cmd = plan[:build_cmd].dup
    cmd[2] = train_count.to_s
    cmd[3] = valid_count.to_s
    plan[:build_cmd] = cmd
    puts "SFT set has #{total} entries — smaller than the #{plan[:slice]} slice (#{plan[:train_count]} train / #{plan[:valid_count]} valid)."
    puts "Auto-split: #{train_count} train / #{valid_count} valid (~20% held out)."
    puts "(Train all of it with: ruby bin/build/build_mlx_data.rb #{total} 0 ...)" if valid_count.zero?
  end

  abort ".venv not found — follow TRAIN.md setup first" unless File.exist?(plan[:lora])

  puts "slice:   qwen3_#{plan[:slice]} (#{train_count} train / #{valid_count} valid)"
  puts "iters:   #{plan[:iters]}"
  puts "adapter: #{plan[:adapter]}"
  puts "model:   #{plan[:model]}"
  puts "watchdog: #{plan[:watchdog] ? 'on' : 'off'}"
  puts "resume:  #{plan[:resume] ? "on (#{plan[:resume_file]})" : 'off'}"
  puts "force:   #{plan[:force] ? 'on (fresh start from base)' : 'off'}"
  puts
  puts "$ #{plan[:build_cmd].join(' ')}"
  puts "$ #{plan[:run_cmd].join(' ')}"
  exit 0 if plan[:dry_run]

  abort "slice build failed" unless system(*plan[:build_cmd])

  snap = snapshot_adapter(plan[:adapter_dir], plan[:slice],
                          File.join(ROOT, "_mlx", "snapshots"))
  puts "Model state saved to #{snap} (rollback: ruby bin/train --restore #{snap})" if snap

  if plan[:force]
    clear_adapter_dir(plan[:adapter_dir])
    puts "Cleared #{plan[:adapter_dir]} — starting fresh from the base model."
  end

  puts "log: #{plan[:log_path]}"
  ok = run_with_log(plan[:run_cmd], plan[:log_path],
                    env: plan[:watchdog] ? { "WATCHDOG" => "1" } : {},
                    append: plan[:resume])

  if ok
    s = last_session_val_summary(plan[:log_path])
    if s
      puts
      puts "Best validation loss this session: #{format('%.3f', s[:best_val])} @ iter #{s[:best_iter]} (baseline #{format('%.3f', s[:baseline_val])}, final #{format('%.3f', s[:final_val])})"
      assess_session_summary(s).each { |line| puts "Session assessment: #{line}" }
    end
  end

  exit(ok ? 0 : 1)
end
